<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runner protocol unit tests and end-to-end tests that run the unchanged goBILDA example code in the JVM
       runner against the simulated robot (spec 12 layers 1, 3 and 4). Needs Java 17 and the Gradle jars
       (scripts/test_java.ps1 builds them). -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\sim\Sim.Runner\Sim.Runner.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Sim.Hardware" />
    <Using Include="Sim.Robots" />
    <Using Include="Sim.Runner" />
  </ItemGroup>
</Project>
