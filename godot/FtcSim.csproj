<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!-- Godot game project (C#). The pure simulation libraries in ../sim are project references. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Sim</RootNamespace>
    <AssemblyName>FtcSim</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\sim\Sim.DriverStation\Sim.DriverStation.csproj" />
    <ProjectReference Include="..\sim\Sim.Game\Sim.Game.csproj" />
    <ProjectReference Include="..\sim\Sim.Editor\Sim.Editor.csproj" />
    <ProjectReference Include="..\sim\Sim.Match\Sim.Match.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Python helper for the synthetic test assets is not part of the build. -->
    <None Remove="test_assets/**" />
  </ItemGroup>
</Project>
